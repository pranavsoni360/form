# ============================================================================
# Backend .env — copy to .env and fill in real values
# ============================================================================
# CRITICAL: Never commit .env. Only this template is tracked.

# ── Environment ─────────────────────────────────────────────────────────────
# Controls log verbosity, refuses-to-boot guards, etc.
# Values: dev | staging | prod (or production)
LOS_ENV=dev
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (Docker Postgres on 5435 via run.sh)
DATABASE_URL=postgresql://los_admin:los_dev_pass@localhost:5432/los_form
# ── Auth secrets (REQUIRED in prod/staging) ─────────────────────────────────
# In prod, both must be >=32 chars or the backend refuses to start.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=devjwtsecret1234567890abcdefghij
ENCRYPTION_KEY=devencryptionkey1234567890abcdef

# ── LiveKit (self-hosted at 164.52.217.236) ─────────────────────────────────
LIVEKIT_URL=ws://164.52.217.236:7880
LIVEKIT_API_KEY=APIz4wNJoLzxewZ
LIVEKIT_API_SECRET=UdHxWuX61VYSolv2yNGCeanCo1ac5LvdwaovqlIL8gR
RECORDING_BASE_URL=http://164.52.217.236:7000

# ── AI provider (BACKEND only uses Gemini, for the transcript analytics
#    cron in backend/agent/analytics.py). The voice-agent worker uses its
#    own STT/TTS/LLM stack (Deepgram, Sarvam, Groq) — those keys live in
#    agent/.env.local, NOT here. Different process, different env file.
GEMINI_API_KEY=your_google_gemini_key

# ── WhatsApp (AiSensy) — backend calls AiSensy directly when the agent
#    POSTs /api/agent/send-whatsapp-form
AISENSY_API_KEY=your_aisensy_key
AISENSY_CAMPAIGN_NAME=otp_verification
AISENSY_FORM_CAMPAIGN=LRS_TESTING
AISENSY_USERNAME=Virtual Galaxy WABA

# ── M1 Observability ────────────────────────────────────────────────────────
# Sentry — leave empty to disable. Get a DSN from https://sentry.io
SENTRY_DSN_BACKEND=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Telegram bot for critical alerts (worker crashes, migrations fail, etc.)
# Setup:
#   1. Telegram -> search @BotFather -> /newbot -> save TOKEN
#   2. /start your new bot
#   3. https://api.telegram.org/bot<TOKEN>/getUpdates -> find chat.id
#      (group chats are negative: -100...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dispatcher tuning ───────────────────────────────────────────────────────
# Calling hours (24h, IST). Outside this window, the dispatcher pauses.
DISPATCHER_STARTING_HOUR=10
DISPATCHER_ENDING_HOUR=18
NUMBER_OF_RETRIES_FOR_CALL=2

# Concurrent in-flight calls cap (M4-lite). For 500/day with one trunk, 5 is
# comfortable. Bump to 10 if you add a second trunk and want to dial faster.
DISPATCHER_CONCURRENCY=5
DISPATCHER_MAX_CALLS_PER_RUN=50

# ── DB pool tuning (M8-lite) ────────────────────────────────────────────────
# Sized for 500/day with comfortable headroom.
# Capacity math: ~6 DB roundtrips/call × ~3 calls/sec peak = ~18 QPS sustained.
# 40 conns absorbs this with room for /readyz, dashboards, ad-hoc psql.
DB_POOL_MIN=10
DB_POOL_MAX=40

# ── M8-lite backups ─────────────────────────────────────────────────────────
# Symmetric passphrase for nightly pg_dump encryption. Generate with:
#   openssl rand -base64 48
# MUST match between pg_backup.sh and restore_test.sh.
BACKUP_GPG_PASSPHRASE=

# rclone remote + bucket for B2 uploads (see DEPLOYMENT.md §3 for setup).
RCLONE_REMOTE=b2:voice-ops-backups
BACKUP_DIR=/var/backups/los
BACKUP_RETENTION_DAYS=14

# ── CORS ────────────────────────────────────────────────────────────────────
# Extra origins beyond localhost + virtualvaani.vgipl.com. Comma-separated.
EXTRA_CORS_ORIGINS=

# ── Postgres container password (consumed by run.sh, not the app) ───────────
LOS_PG_PASSWORD=los_dev_pass
