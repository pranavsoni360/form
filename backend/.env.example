# ============================================================================
# Backend .env — copy to .env and fill in real values
# ============================================================================
# CRITICAL: Never commit .env. Only this template is tracked.

# ── Environment ─────────────────────────────────────────────────────────────
# Controls log verbosity, refuses-to-boot guards, etc.
# Values: dev | staging | prod (or production)
LOS_ENV=dev
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (Docker Postgres on 5435 via run.sh)
DATABASE_URL=postgresql://los_admin:los_dev_pass@localhost:5432/los_form
# ── Auth secrets (REQUIRED in prod/staging) ─────────────────────────────────
# In prod, both must be >=32 chars or the backend refuses to start.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=devjwtsecret1234567890abcdefghij
ENCRYPTION_KEY=devencryptionkey1234567890abcdef

# ── LiveKit (self-hosted at 164.52.217.236) ─────────────────────────────────
LIVEKIT_URL=ws://164.52.217.236:7880
LIVEKIT_API_KEY=APIz4wNJoLzxewZ
LIVEKIT_API_SECRET=UdHxWuX61VYSolv2yNGCeanCo1ac5LvdwaovqlIL8gR
RECORDING_BASE_URL=http://164.52.217.236:7000

# ── AI provider (BACKEND only uses Gemini, for the transcript analytics
#    cron in backend/agent/analytics.py). The voice-agent worker uses its
#    own STT/TTS/LLM stack (Deepgram, Sarvam, Groq) — those keys live in
#    agent/.env.local, NOT here. Different process, different env file.
GEMINI_API_KEY=your_google_gemini_key

# ── WhatsApp (AiSensy) — backend calls AiSensy directly when the agent
#    POSTs /api/agent/send-whatsapp-form
AISENSY_API_KEY=your_aisensy_key
AISENSY_CAMPAIGN_NAME=otp_verification
# Form-link campaign. Use a UTILITY-category template (e.g. form_link_u), NOT a
# Marketing one — Meta throttles Marketing templates ("not delivered to maintain
# healthy ecosystem engagement"), while Utility follow-ups (sent right after the
# customer agreed on the call) deliver reliably.
AISENSY_FORM_CAMPAIGN=form_link_u
AISENSY_USERNAME=Virtual Galaxy WABA
# Don't re-send a form link to the same number within this many hours (dedup
# guard against WhatsApp/Meta frequency blocks). 0 disables. Default 24.
FORM_RESEND_COOLDOWN_HOURS=24

# ── M1 Observability ────────────────────────────────────────────────────────
# Sentry — leave empty to disable. Get a DSN from https://sentry.io
SENTRY_DSN_BACKEND=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Telegram bot for critical alerts (worker crashes, migrations fail, etc.)
# Setup:
#   1. Telegram -> search @BotFather -> /newbot -> save TOKEN
#   2. /start your new bot
#   3. https://api.telegram.org/bot<TOKEN>/getUpdates -> find chat.id
#      (group chats are negative: -100...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dispatcher tuning ───────────────────────────────────────────────────────
# Calling hours (24h, IST). Outside this window, the dispatcher pauses.
DISPATCHER_STARTING_HOUR=10
DISPATCHER_ENDING_HOUR=18
NUMBER_OF_RETRIES_FOR_CALL=2

# Concurrent in-flight calls cap (M4-lite). For 500/day with one trunk, 5 is
# comfortable. Bump to 10 if you add a second trunk and want to dial faster.
DISPATCHER_CONCURRENCY=5
DISPATCHER_MAX_CALLS_PER_RUN=50

# ── DB pool tuning (M8-lite) ────────────────────────────────────────────────
# Sized for 500/day with comfortable headroom.
# Capacity math: ~6 DB roundtrips/call × ~3 calls/sec peak = ~18 QPS sustained.
# 40 conns absorbs this with room for /readyz, dashboards, ad-hoc psql.
DB_POOL_MIN=10
DB_POOL_MAX=40

# ── M8-lite backups ─────────────────────────────────────────────────────────
# Symmetric passphrase for nightly pg_dump encryption. Generate with:
#   openssl rand -base64 48
# MUST match between pg_backup.sh and restore_test.sh.
BACKUP_GPG_PASSPHRASE=

# rclone remote + bucket for B2 uploads (see DEPLOYMENT.md §3 for setup).
RCLONE_REMOTE=b2:voice-ops-backups
BACKUP_DIR=/var/backups/los
BACKUP_RETENTION_DAYS=14

# ── CORS ────────────────────────────────────────────────────────────────────
# Extra origins beyond localhost + virtualvaani.vgipl.com. Comma-separated.
EXTRA_CORS_ORIGINS=

# ── Postgres container password (consumed by run.sh, not the app) ───────────
LOS_PG_PASSWORD=los_dev_pass

# ── VG Docverify (PAN, Aadhaar/DigiLocker, Experian, ITR, Account Aggregator) ─
#
# ONE variable picks the environment for EVERY VG call. Credentials are derived
# FROM this host (lrs/providers/vg_docverify.py::_creds_for), so host and
# credentials can never disagree — do not set the user/key below just to switch
# environment, change this instead.
#
#   http://10.200.10.43/VGDocverify        UAT — OFFICE LAN ONLY, not routable
#                                          from the QA/prod servers
#   http://galaxypay.in:9002/VGDocverify   UAT — same service, public address.
#                                          USE THIS on any deployed server.
#   https://vpays.in/VGDocverify           PRODUCTION (different credentials)
#
# Leaving this UNSET is the trap it looks like: each module then falls back to
# its own hard-coded default, and they do not agree — itr_routes/aa_routes
# defaulted to production while the provider defaulted to UAT, so UAT
# credentials were sent to the production host and every ITR fetch failed with
# "no return found". Always set it explicitly.
#
# Symptom → cause: "Could not reach the income-tax service" means this host is
# not routable from the server (test with curl ON THE SERVER, not your laptop).
VG_DOCVERIFY_BASE_URL=http://galaxypay.in:9002/VGDocverify

# Optional overrides. Only set these for a host _creds_for does not recognise;
# otherwise they silently decouple the credentials from the host above.
# VG_DOCVERIFY_USER_ID=
# VG_DOCVERIFY_VERIFICATION_KEY=
# VG_DOCVERIFY_BANK_NAME=
# VG_DOCVERIFY_BANK_SHORT_CODE=

# Request metadata sent with every VG call. Defaults are fine.
# VG_DOCVERIFY_APP_MODE=LRS
# VG_DOCVERIFY_REQUEST_FROM=LRS
# VG_DOCVERIFY_DEVICE_ID=lrs-backend
# VG_DOCVERIFY_TIMEOUT=30

# Experian/ProteanCredit SOAP shape. Change only if VG changes their WSDL.
# VG_EXPERIAN_METHOD=
# VG_EXPERIAN_ELEM=

# ── ITR ─────────────────────────────────────────────────────────────────────
# How many assessment years the customer-facing "Generate" fetches.
ITR_DEFAULT_YEARS=3

# Allows the ITR credential POST over plain HTTP. LOCAL DEVELOPMENT ONLY — this
# endpoint carries the applicant's income-tax portal password, which must never
# cross a plaintext link in a deployed environment. Leave unset everywhere else.
# ITR_ALLOW_INSECURE=

# DO NOT SET THESE.
# ITRIncomeProvider applies them to EVERY applicant during LRS scoring — one
# person's income-tax portal login used to fetch other people's returns. They
# exist only as a pre-Generate development stub. The customer-facing flow
# (/api/itr/generate) takes each applicant's own credentials, uses them once and
# discards them, which is the only acceptable pattern here.
# VG_DOCVERIFY_ITR_USERNAME=
# VG_DOCVERIFY_ITR_PASSWORD=

# ── Account Aggregator (bank statements) ────────────────────────────────────
# Where VG sends the borrower after the upload journey.
# AA_RETURN_URL=https://www.vgipl.com
# Where VG posts the completion callback. Must be reachable from VG's network.
# AA_CALLBACK_URL=http://galaxypay.in:9002/VGDocverify/VGIL_TxnCallback.aspx
