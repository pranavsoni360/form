# frontend/.env.local — local dev secrets, NOT committed
# Copy to `.env.local` and fill in the placeholders. Restart `next start`
# after any change.

# ── API ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8200

# ── Sentry (browser SDK — public DSN, safe to expose) ────────────
# Get the DSN from sentry.io → Settings → Projects → <your-frontend-project>
#                            → Client Keys (DSN) → Copy DSN
# Region matters: if your org is on EU, DSN host will end in `.de.sentry.io`
# (use https://de.sentry.io to view events). US org uses `.sentry.io`.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_LOS_ENV=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Sentry (build-time — server-only, NOT public) ────────────────
# Needed only for source-map upload during `next build`. Without these,
# the app still builds and Sentry still captures errors — stack traces
# just show minified column/line numbers.
# Create the auth token at: sentry.io → Settings → Auth Tokens → Create
# Scope needed: `project:releases`, `project:write`, `org:read`
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
